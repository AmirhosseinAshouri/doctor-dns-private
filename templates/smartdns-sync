            "سرویس گاهی کار کند و گاهی نه.</p></div>" % html.escape(ip))


def human_fa(n):
    n = float(n or 0)
    for unit in ("بایت", "کیلوبایت", "مگابایت", "گیگابایت", "ترابایت"):
        if n < 1024 or unit == "ترابایت":
            return ("%d %s" if unit == "بایت" else "%.2f %s") % (n, unit)
        n /= 1024


